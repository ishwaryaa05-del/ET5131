// CareerGPS4u data model

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Market {
  SINGAPORE
  MALAYSIA
  MYANMAR
}

enum PracticeLanguage {
  ENGLISH
  BURMESE
  MALAY
  TAMIL
  MIXED
}

enum RoleLevel {
  INTERNSHIP
  ENTRY_LEVEL
  ASSOCIATE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  profile           Profile?
  jobDescriptions   JobDescription[]
  resumes           Resume[]
  interviewSessions InterviewSession[]
  riasecResults     RiasecResult[]
  skillGapReports   SkillGapReport[]
  taskClaims        TaskClaim[]
}

model Profile {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  market           Market
  industry         String
  practiceLanguage PracticeLanguage
  updatedAt        DateTime         @updatedAt
}

model JobDescription {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  rawText   String
  industry  String
  roleLevel RoleLevel
  source    String // "pasted" | "pdf"
  createdAt DateTime  @default(now())

  questionSet       InterviewQuestionSet?
  interviewSessions InterviewSession[]
  skillGapReports   SkillGapReport[]
}

model InterviewQuestionSet {
  id        String         @id @default(cuid())
  jdId      String         @unique
  jd        JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)
  questions Json // [{ question, strongAnswerNote }]
  createdAt DateTime       @default(now())
}

model InterviewSession {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jdId      String
  jd        JobDescription   @relation(fields: [jdId], references: [id], onDelete: Cascade)
  language  PracticeLanguage
  startedAt DateTime         @default(now())

  turns InterviewTurn[]
}

model InterviewTurn {
  id              String           @id @default(cuid())
  sessionId       String
  session         InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionIndex   Int
  questionText    String
  answerText      String
  answerLanguage  PracticeLanguage
  feedback        Json // { contentScore, deliveryScore, culturalFitScore, dualTongueNotes:[{original,issue,suggestedEnglish}], summary, nativeLanguageFeedback, modelEnglishAnswer }
  englishPractice Json? // { attemptText, feedback: { fluencyScore, summary, corrections:[], possibleMispronunciations:[] } }
  createdAt       DateTime         @default(now())
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawText   String
  source    String // "pasted" | "pdf"
  tailoring Json? // { formatSuggestions:[], contentSuggestions:[], targetJdId }
  createdAt DateTime @default(now())
}

model RiasecResult {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers        Json // [{itemId, score}]
  scores         Json // { R,I,A,S,E,C }
  code           String // e.g. "RIA"
  interpretation Json // { summary, marketNotes:[], strengths:[], watchOuts:[] }
  createdAt      DateTime @default(now())
}

model SkillGapReport {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jdId      String
  jd        JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)
  resumeId  String
  gaps      Json // [{ skill, why, courses:[{platform,title,url}] }]
  createdAt DateTime       @default(now())
}

// ---------- Sponsor Task Exchange ----------
// Self-contained module: sponsors fund free student access by posting small,
// scoped tasks; students claim, complete, and get access extended in return.

enum TaskTier {
  VISIBILITY // Tier 1
  FEEDBACK // Tier 2
  APPLIED_PROJECT // Tier 3
}

enum TaskStatus {
  OPEN
  CLOSED
}

enum ClaimStatus {
  CLAIMED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  AUTO_APPROVED
}

enum SubmissionType {
  URL
  FILE
  FORM_RESPONSE
}

model Sponsor {
  id           String   @id @default(cuid())
  companyName  String
  industry     String
  contactName  String
  contactEmail String   @unique
  passwordHash String
  logoUrl      String?
  createdAt    DateTime @default(now())

  tasks Task[]
}

model Task {
  id           String     @id @default(cuid())
  sponsorId    String
  sponsor      Sponsor    @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  tier         TaskTier
  title        String
  description  String
  formFields   Json? // Tier 2 only: [{ key, label, required }]
  seatCap      Int
  seatsClaimed Int        @default(0)
  hourCap      Int // derived from tier at creation time, never sponsor-set
  status       TaskStatus @default(OPEN)
  createdAt    DateTime   @default(now())

  claims TaskClaim[]
}

model TaskClaim {
  id                  String          @id @default(cuid())
  taskId              String
  task                Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studentId           String
  student             User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status              ClaimStatus     @default(CLAIMED)
  agreementVersion    Int // version of the tier's agreement template accepted
  agreementAcceptedAt DateTime        @default(now())
  submissionType      SubmissionType?
  submissionContent   Json? // { url } | { fields: {...} } | { path, filename, size }
  precheckNotes       Json? // string[] of issues from the last failed automated pre-check
  claimedAt           DateTime        @default(now())
  submittedAt         DateTime?
  reviewDeadline      DateTime?
  reviewedAt          DateTime?
  reviewer            String? // "auto" | sponsor contact name
  reviewNote          String?
  accessGrantedUntil  DateTime?

  @@unique([taskId, studentId])
}
